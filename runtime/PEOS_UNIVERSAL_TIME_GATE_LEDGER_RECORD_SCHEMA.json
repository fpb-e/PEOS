{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "peos://runtime/universal-time-gate/ledger-record/rev0.311",
  "title": "PEOS rev0.311 universal gate canonical ledger record",
  "type": "object",
  "required": [
    "record_type", "schema_version", "ledger_seq", "turn_id", "session_id",
    "route", "user_turn_observed_at_jst", "visible_timestamp", "provider",
    "implementation_path", "capture_path_class", "capture_attempts",
    "successful_peos_executable_action_index", "runtime_order_valid",
    "persistence_status", "canonical_for_log_reconstruction"
  ],
  "properties": {
    "record_type": {"const": "TURN_TIME_RECORD"},
    "schema_version": {"const": "rev0.311"},
    "ledger_seq": {"type": "integer", "minimum": 1},
    "turn_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "route": {
      "enum": [
        "BOOT", "NORMAL_CONVERSATION", "CASUAL_CHAT", "SHORT_ACK", "FILE",
        "IMAGE", "WEB_TOOL", "AUTOMATION", "LOG_GENERATION", "SPECIFICATION",
        "PACKAGE_ZIP", "DEVICE", "TRAVEL"
      ]
    },
    "user_turn_observed_at_jst": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} JST$"
    },
    "visible_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} JST$"
    },
    "provider": {"type": "string", "minLength": 1},
    "implementation_path": {"type": "string", "minLength": 1},
    "capture_path_class": {"enum": ["REFERENCE_PYTHON_PATH", "TRUSTED_PATH_VARIANCE"]},
    "capture_attempts": {"type": "integer", "minimum": 1},
    "successful_peos_executable_action_index": {"const": 1},
    "runtime_order_valid": {"const": true},
    "persistence_status": {"const": "PERSISTED_VERIFIED"},
    "canonical_for_log_reconstruction": {"const": true}
  },
  "additionalProperties": true
}
