{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PEOS rev0.308 plain-verbatim session event schema with persistent time-ledger authority",
  "type": "object",
  "required": [
    "seq",
    "turn_id",
    "event_order",
    "role",
    "channel",
    "event_type",
    "time",
    "body_verbatim"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "event_order": {
      "type": "integer",
      "minimum": 1
    },
    "role": {
      "enum": [
        "user",
        "assistant",
        "tool",
        "system_gap",
        "attachment",
        "automation"
      ]
    },
    "channel": {
      "type": "string"
    },
    "event_type": {
      "enum": [
        "user_message",
        "assistant_commentary",
        "assistant_final",
        "tool_receipt",
        "source_gap",
        "attachment_event",
        "automation_event"
      ]
    },
    "time": {
      "type": "object",
      "required": [
        "TURN_TIME_STATUS",
        "TIME_EVIDENCE_CLASS",
        "TIME_AUTHORITY"
      ],
      "properties": {
        "TURN_TIME_STATUS": {
          "type": "string"
        },
        "USER_TURN_OBSERVED_AT_JST": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} JST$",
          "not": {
            "enum": [
              "UNAVAILABLE",
              "N/A",
              "UNKNOWN",
              ""
            ]
          }
        },
        "TIME_EVIDENCE_CLASS": {
          "type": "string"
        },
        "TIME_AUTHORITY": {
          "type": "string"
        },
        "LEDGER_SEQ": {
          "type": "integer",
          "minimum": 1
        },
        "LEDGER_IDEMPOTENCY_KEY": {
          "type": "string",
          "minLength": 8
        },
        "PERSISTENCE_STATUS": {
          "enum": [
            "PERSISTED_VERIFIED",
            "PERSISTENCE_FAILED",
            "NOT_APPLICABLE"
          ]
        }
      },
      "additionalProperties": true
    },
    "body_verbatim": {
      "type": "string"
    },
    "attachments": {
      "type": "array"
    },
    "attachment": {
      "type": "object"
    },
    "source_gap_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
